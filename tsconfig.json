{
	"compilerOptions": {
		// 按 ES2022 语义检查源码；发布产物的运行时目标由 tsdown 单独指定。
		"target": "ES2022",
		// Vue TSX 类型保留 JSX，实际转换由消费项目完成。
		"jsx": "preserve",
		// 覆盖现代浏览器、WebView 和可迭代 DOM 集合。
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		// 强制所有输入按模块处理，避免无 import/export 文件退化为全局脚本。
		"moduleDetection": "force",
		// 保留 ESM 语法交由 tsdown 构建。
		"module": "ESNext",
		// 按打包器规则解析 package exports 和 ESM。
		"moduleResolution": "Bundler",
		// 不自动引入 @types 全局声明；显式导入的模块仍会解析其类型。
		"types": [],
		// 启用 strict 选项族；额外检查及单项覆盖由下方选项决定。
		"strict": true,
		// 派生类覆盖成员时必须显式使用 override。
		"noImplicitOverride": true,
		// 索引签名属性必须使用方括号访问，明确区分动态键和固定字段。
		"noPropertyAccessFromIndexSignature": true,
		// 索引访问结果包含 undefined，强制处理越界或缺失键。
		"noUncheckedIndexedAccess": true,
		// 未使用的局部变量和参数视为错误。
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		// TypeScript 只负责检查，JavaScript 和声明产物统一由 tsdown 生成。
		"noEmit": true,
		// 兼容以默认导入形式使用 CommonJS 依赖 crypto-js。
		"esModuleInterop": true,
		// 防止大小写不同的导入路径在 Linux CI 中失效。
		"forceConsistentCasingInFileNames": true,
		// 每个文件必须可由 tsdown 独立转换。
		"isolatedModules": true,
		// 保留 ESM 导入导出，并要求类型导入显式使用 type。
		"verbatimModuleSyntax": true,
		// 跳过第三方声明文件噪声；包契约测试会检查真实消费者类型。
		"skipLibCheck": true
	},
	// 检查库源码和唯一构建配置；测试使用 tests/tsconfig.json。
	"include": ["src", "tsdown.config.ts"],
	// 排除依赖和发布产物。
	"exclude": ["node_modules", "dist"]
}
